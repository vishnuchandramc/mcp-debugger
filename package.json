{
  "name": "flow",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix app\" \"wait-on http://localhost:5173 && electron .\"",
    "electron": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.flow.app",
    "productName": "Flow",
    "directories": {
      "app": "."
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "app/dist/**/*",
      "assets/**/*"
    ]
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  }
}
